# Copy this file to .env.local and fill in real values.
#
#   cp .env.example .env.local
#
# .env.local is gitignored — never commit real secrets.
# Vars prefixed with NEXT_PUBLIC_ are inlined into the client bundle
# and are therefore PUBLIC. Never put a secret behind that prefix.

# Base URL of the Anime Qatoto backend API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
